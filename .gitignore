# ホワイトリスト方式: トップレベルはデフォルトで全て無視し、
# 追跡するファイル・ディレクトリだけを ! で明示的に許可する。
# 新しい dotfile を追加したらここに1行追加する。
/*

# --- 追跡するファイル ---
!/.gitignore
!/Brewfile
!/Brewfile.private
!/Brewfile.work
!/CLAUDE.md
!/README.md
!/setup.sh
!/link.sh
!/brew.sh

# --- 追跡するディレクトリ ---
# home/ は $HOME のミラー（配下は自動追跡）。それ以外は例外アセット・repo ツール。
!/home/
!/claude/
!/shared/
!/ghostty/
!/via/
!/vscode/

# --- home/.claude/commands はコマンドごとにホワイトリスト指定 ---
# 自作コマンドを追加したらここに1行追加する。
/home/.claude/commands/*

# --- claude/agents はエージェントごとにホワイトリスト指定 ---
# 自作エージェントを追加したらここに1行追加する。
/claude/agents/*

# --- shared/skills はスキルごとにホワイトリスト指定 ---
# 自作スキルを追加したらここに1行追加する。
# 外部リポジトリ由来の skills（skills-manifest.txt で管理）は許可しない。
/shared/skills/*
!/shared/skills/commit-pr/
!/shared/skills/empirical-prompt-tuning/
!/shared/skills/steering/


# --- 許可したディレクトリ内でも除外するもの ---
.DS_Store
*.log
*credentials*
*secret*
*.pem
*.key

# マシンローカル。home/ に置き link.sh で ~ へリンクするが、追跡しない。
/home/.zshrc.local
/home/.gitconfig
/home/.config/zsh/profile
